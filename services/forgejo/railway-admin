#!/bin/bash
# One-shot s6 service: create the first Forgejo administrator from Railway variables.
#
#   FORGEJO_ADMIN_USERNAME / FORGEJO_ADMIN_PASSWORD / FORGEJO_ADMIN_EMAIL
#     Used only while the instance has no administrator. After that the account is
#     managed in Forgejo (password changes in the UI survive redeploys).
#   FORGEJO_ADMIN_PASSWORD_RESET=true
#     Set the password of FORGEJO_ADMIN_USERNAME to FORGEJO_ADMIN_PASSWORD on this boot
#     (account recovery). Set it back to false afterwards.
#
# Values typed into the deploy form never fail the deploy (STANDARD 8.29): an invalid
# user name or e-mail falls back to the default with a warning; an unusable password
# creates no administrator (registration is closed, so nobody else can sign up) and the
# log says how to fix it. The web server keeps running in every case.
exec 2>&1
set -uo pipefail

DEFAULT_USER="forgejo-admin"
DEFAULT_EMAIL="admin@example.com"
WAIT_SECONDS=1200
HTTP_PORT="${FORGEJO__server__HTTP_PORT:-3000}"
[[ "${HTTP_PORT}" =~ ^[0-9]{1,5}$ ]] || HTTP_PORT=3000

log() { printf '[railway-admin] %s\n' "$*"; }

# Run once per container start: s6 must not restart this service after it exits.
finish() { s6-svc -O "$(pwd)" 2>/dev/null; exit 0; }

forgejo() { (cd /app/gitea && su-exec git /usr/local/bin/gitea "$@"); }

valid_name() {
  local name="$1"
  [[ "${name}" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]{0,38}[A-Za-z0-9])?$ ]] || return 1
  # Names Forgejo reserves for routes (checked case-insensitively).
  case "${name,,}" in
    admin|api|assets|attachments|avatar|avatars|captcha|commits|debug|devtest|error|explore|favicon.ico|ghost|issues|login|manifest.json|metrics|milestones|new|notifications|org|pulls|raw|repo|repo-avatars|robots.txt|search|serviceworker.js|ssh_info|swagger.v1.json|user|v2|gitea-actions|forgejo-actions) return 1 ;;
  esac
}

wait_for_forgejo() {
  local waited=0
  until curl -fsS -o /dev/null --max-time 5 "http://127.0.0.1:${HTTP_PORT}/api/healthz"; do
    if [ "${waited}" -ge "${WAIT_SECONDS}" ]; then
      log "Forgejo did not become healthy within ${WAIT_SECONDS}s; no administrator bootstrap on this boot."
      finish
    fi
    sleep 5
    waited=$((waited + 5))
  done
}

main() {
  local name="${FORGEJO_ADMIN_USERNAME:-}" email="${FORGEJO_ADMIN_EMAIL:-}" pass="${FORGEJO_ADMIN_PASSWORD:-}"
  local reset="${FORGEJO_ADMIN_PASSWORD_RESET:-false}" admins out

  if ! valid_name "${name}"; then
    log "WARNING: FORGEJO_ADMIN_USERNAME '${name}' is not a usable Forgejo user name (letters, digits, . _ -, max 40, not a reserved name like 'admin'); using '${DEFAULT_USER}'."
    name="${DEFAULT_USER}"
  fi
  if ! [[ "${email}" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]]; then
    log "WARNING: FORGEJO_ADMIN_EMAIL is not an e-mail address; using '${DEFAULT_EMAIL}' (change it later in your Forgejo profile)."
    email="${DEFAULT_EMAIL}"
  fi

  wait_for_forgejo

  if ! admins="$(forgejo admin user list --admin 2>&1)"; then
    log "WARNING: could not list users (${admins##*$'\n'}); no administrator bootstrap on this boot."
    finish
  fi

  # Header line + one line per administrator.
  if [ "$(printf '%s\n' "${admins}" | sed '1d' | grep -c .)" -gt 0 ]; then
    if [ "${reset,,}" = "true" ]; then
      if [ "${#pass}" -lt 8 ]; then
        log "WARNING: FORGEJO_ADMIN_PASSWORD_RESET=true but FORGEJO_ADMIN_PASSWORD is shorter than 8 characters; password left unchanged."
      elif out="$(forgejo admin user change-password --username "${name}" --password "${pass}" --must-change-password=false 2>&1)"; then
        log "Password of '${name}' set from FORGEJO_ADMIN_PASSWORD. Set FORGEJO_ADMIN_PASSWORD_RESET back to false."
      else
        log "WARNING: password reset for '${name}' failed: ${out##*$'\n'}"
      fi
    else
      log "An administrator already exists; nothing to do (the admin account is managed in Forgejo)."
    fi
    finish
  fi

  if [ "${#pass}" -lt 8 ]; then
    log "NOT creating the administrator: FORGEJO_ADMIN_PASSWORD must have at least 8 characters. Registration is closed, so the instance stays locked: set a longer FORGEJO_ADMIN_PASSWORD and redeploy."
    finish
  fi

  if out="$(forgejo admin user create --admin --username "${name}" --password "${pass}" --email "${email}" --must-change-password=false 2>&1)"; then
    log "Administrator '${name}' created. Sign in with FORGEJO_ADMIN_PASSWORD."
  elif [ "${name}" != "${DEFAULT_USER}" ] && out="$(forgejo admin user create --admin --username "${DEFAULT_USER}" --password "${pass}" --email "${email}" --must-change-password=false 2>&1)"; then
    log "WARNING: Forgejo refused the name '${name}'; administrator '${DEFAULT_USER}' created instead."
  else
    log "WARNING: administrator not created: ${out##*$'\n'}"
    log "Fix FORGEJO_ADMIN_USERNAME / FORGEJO_ADMIN_PASSWORD / FORGEJO_ADMIN_EMAIL and redeploy; registration stays closed meanwhile."
  fi
  finish
}

main
